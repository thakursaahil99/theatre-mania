# Where the Next.js server reaches the FastAPI backend (server components + /api/v1 proxy).
# Docker Compose: http://backend:8000   Local: http://localhost:8000   Vercel: https://api.yourdomain.com
API_INTERNAL_URL=http://localhost:8000

# Public site URL (used for metadata / OpenGraph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" to show the Google sign-in button (backend must have GOOGLE_CLIENT_ID/SECRET).
NEXT_PUBLIC_GOOGLE_AUTH=false

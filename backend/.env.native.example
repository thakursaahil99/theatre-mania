# Native development (no Docker). `npm run setup` copies this to backend/.env and fills in
# JWT_SECRET and the FFmpeg paths. `npm run dev` overrides the URL/port values at runtime.

ENV=dev
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
ADMIN_EMAILS=admin@example.com

# SQLite file (WAL mode). To use your own Postgres instead:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/cineverse
DATABASE_URL=sqlite+aiosqlite:///./data/cineverse.db

# In-process cache/rate limits + Celery filesystem broker (no Redis server needed).
REDIS_URL=memory://
HOME_CACHE_TTL=30

# Files on disk, served by the API with HMAC-signed, expiring URLs.
STORAGE_BACKEND=local
LOCAL_MEDIA_DIR=./data/media
LOCAL_DATA_DIR=./data
TRANSCODE_WORKDIR=./data/transcode

JWT_SECRET=__generated_by_setup__
COOKIE_SECURE=false

# FFmpeg: setup downloads a portable build into backend/.tools/ffmpeg on Windows.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# TMDB (https://www.themoviedb.org/settings/api): posters, cast, trailers, rows.
TMDB_READ_TOKEN=
TMDB_API_KEY=
# Where to Watch region (JioHotstar, Prime, Netflix, ZEE5, SonyLIV… for IN)
TMDB_REGION=IN

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

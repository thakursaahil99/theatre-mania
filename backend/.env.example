# ---------- App ----------
ENV=dev
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HEADERS=false
# Comma-separated; these accounts become admins on signup / first Google login.
ADMIN_EMAILS=admin@example.com

# ---------- Database / cache ----------
DATABASE_URL=postgresql+asyncpg://cineverse:cineverse@postgres:5432/cineverse
REDIS_URL=redis://redis:6379/0

# ---------- Auth ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-secret-of-at-least-32-chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.yourdomain.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must go through the frontend origin (Next.js proxies /api/v1/* to this API).
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# ---------- TMDB (https://www.themoviedb.org/settings/api) ----------
TMDB_READ_TOKEN=
TMDB_API_KEY=
TMDB_LANGUAGE=en-US
TMDB_REGION=US

# ---------- Object storage ----------
# Local SeaweedFS (docker compose). For Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com, region "auto".
S3_ENDPOINT_URL=http://storage:8333
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=cineverse-media

# ---------- Streaming ----------
# s3  = presigned bucket URLs per segment
# cdn = CDN_BASE_URL + nginx secure_link_md5 (see infra/nginx/nginx.conf)
STREAM_SIGNING_MODE=s3
CDN_BASE_URL=
CDN_SIGNING_SECRET=
PLAYBACK_TOKEN_TTL_SEC=14400
SEGMENT_URL_TTL_SEC=21600

# ---------- Pipeline ----------
TRANSCODE_WORKDIR=/tmp/cineverse
HLS_SEGMENT_SECONDS=6
X264_PRESET=veryfast
IMPORT_ALLOWED_HOSTS=archive.org,.archive.org
